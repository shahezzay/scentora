# PostgreSQL connection string (Railway / Neon / Supabase all give you one)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Your admin login (created automatically on first request). Use it at /account, then open /admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Only set to true if your database host requires SSL and the URL has no ?sslmode=require
# PGSSL=false
